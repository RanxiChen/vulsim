#include <bit>
#include <cstdio>
#include <cstdlib>
#include <defhelper.hpp>
#include <run.hpp>

TOP("./FASEPopcountTop.vul");
PROJECT(".");

REQUEST(host2ctrl, handshake=1, ARG(uint8_t) data);
QUERY(pending, bool);
QUERY(buffered, bool);
QUERY(bytes_done, uint8_t);
QUERY(partial_count, uint32_t);
QUERY(fetch_stopped, bool);

GLOBAL() {
    unsigned cycle = 0;
    unsigned checks = 0;
    bool host_ready = true;
    bool result_ready = true;
    unsigned replies = 0;
    uint8_t last_reply = 0;
    unsigned results = 0;
    uint32_t last_inst = 0;
    uint32_t last_ones = 0;
}

SERVICE(ctrl2host, handshake=1, ready=host_ready, ARG(uint8_t) data) {
    ++replies;
    last_reply = data;
}

SERVICE(result, handshake=1, ready=result_ready,
    ARG(uint32_t) inst, ARG(uint32_t) ones) {
    ++results;
    last_inst = inst;
    last_ones = ones;
}

SIMULATION() {
    auto check = [&](bool ok, const char* what) {
        ++checks;
        if (!ok) {
            std::printf("FAIL FASE popcount cycle=%u results=%u replies=%u: %s\n",
                        cycle, results, replies, what);
            std::exit(1);
        }
    };
    auto step = [&]() {
        sim_nextcycle();
        ++cycle;
        check(cycle < 1000U, "timeout");
        check(fetch_stopped(), "M-mode stop_fetch reaches the actual backend");
    };
    auto send = [&](uint8_t byte) {
        check(host2ctrl(byte), "Host byte must be accepted");
        step();
    };
    auto blocked = [&]() {
        check(!host2ctrl(0x1eU), "outstanding command must block another head");
        step();
    };
    auto command = [&](uint8_t head, uint32_t inst, bool gaps) {
        unsigned old_results = results;
        unsigned old_replies = replies;
        send(head);
        send(0);
        for (unsigned i = 0; i < 4U; ++i) {
            if (gaps) step();
            send(static_cast<uint8_t>(inst >> (i * 8U)));
            check(results == old_results && replies == old_replies,
                  "partial frame cannot produce a result or completion");
            check(!pending(), "no backend acceptance before complete frame boundary");
        }
    };
    auto compute_after_accept = [&](uint32_t inst) {
        unsigned old_results = results;
        unsigned old_replies = replies;
        check(pending() && buffered(), "accepted instruction is visibly in the FIFO");
        blocked();  // FIFO -> work registers. Counting starts next cycle.
        check(pending() && !buffered(), "dequeue retains pending");
        check(bytes_done() == 0U && partial_count() == 0U, "work starts at zero");
        for (unsigned n = 1; n <= 4U; ++n) {
            blocked();
            uint32_t prefix = inst;
            if (n < 4U) prefix = inst & ((1U << (n * 8U)) - 1U);
            check(bytes_done() == n, "exactly one byte processed per cycle");
            check(partial_count() == static_cast<uint32_t>(std::popcount(prefix)),
                  "partial count matches the processed-byte prefix");
            check(pending() == (n < 4U), "pending clears only at fourth count boundary");
            check(results == old_results && replies == old_replies,
                  "no early result or Host completion during four count cycles");
        }
    };
    auto accept_and_compute = [&](uint32_t inst) {
        check(!pending() && !buffered(), "complete frame first waits in controller");
        blocked();  // Controller -> backend FIFO acceptance boundary.
        compute_after_accept(inst);
    };
    auto check_result = [&](unsigned old_results, uint32_t inst) {
        check(results == old_results + 1U && last_inst == inst,
              "one ordered result with the original instruction");
        check(last_ones == static_cast<uint32_t>(std::popcount(inst)), "final popcount");
    };

    step();
    check(!pending() && !buffered(), "reset is idle");

    // Unsupported command is rejected by the IP without entering the backend.
    send(0x09U);
    blocked();
    check(replies == 1U && last_reply == 0xffU, "unsupported head returns error");
    check(results == 0U && !pending() && !buffered(), "error does not reach backend");

    const uint32_t words[6] = {
        0U, 0xffffffffU, 1U, 0x80000000U, 0xaaaaaaaaU, 0x12345678U
    };
    for (unsigned i = 0; i < 6U; ++i) {
        uint8_t head = static_cast<uint8_t>((i << 5U) | 30U);
        unsigned old_results = results;
        unsigned old_replies = replies;
        host_ready = (i != 4U);
        command(head, words[i], (i & 1U) != 0U);
        accept_and_compute(words[i]);
        blocked();  // Buffered result is observed; controller prepares its ACK.
        check_result(old_results, words[i]);
        check(replies == old_replies, "Host completion follows backend completion");
        if (!host_ready) {
            for (unsigned j = 0; j < 3U; ++j) blocked();
            check(replies == old_replies && results == old_results + 1U,
                  "Host backpressure does not lose or duplicate a result");
            host_ready = true;
        }
        blocked();
        check(replies == old_replies + 1U && last_reply == head, "success head echoed once");
    }

    // A held result survives even after pending clears and the Host is answered.
    unsigned old_results = results;
    unsigned old_replies = replies;
    const uint32_t first = 0xf0ff0301U;
    const uint32_t second = 0x00ff00ffU;
    result_ready = false;
    command(0xdeU, first, false);
    accept_and_compute(first);
    blocked();
    blocked();
    check(results == old_results && replies == old_replies + 1U && last_reply == 0xdeU,
          "completed data is retained independently of Host ACK");

    command(0xfeU, second, true);
    for (unsigned j = 0; j < 3U; ++j) blocked();
    check(!pending() && !buffered() && results == old_results,
          "held result backpressures the next CPU injection");
    check(replies == old_replies + 1U, "blocked injection has no premature ACK");
    result_ready = true;
    blocked();  // Drain first result; next injection still waits at this boundary.
    check_result(old_results, first);
    check(!pending() && !buffered(), "old result cannot be overwritten on its drain cycle");
    blocked();  // Second instruction is now accepted.
    compute_after_accept(second);
    blocked();
    check_result(old_results + 1U, second);
    blocked();
    check(replies == old_replies + 2U && last_reply == 0xfeU, "backpressured command completes");

    // Reset in the middle of the four-cycle calculation aborts both components.
    old_results = results;
    old_replies = replies;
    command(0x1eU, 0x13579bdfU, false);
    blocked();  // Accept.
    blocked();  // Dequeue.
    blocked();  // Byte 1.
    blocked();  // Byte 2.
    check(pending() && bytes_done() == 2U, "reset test is actually mid-calculation");
    sim_reset();
    for (unsigned j = 0; j < 3U; ++j) step();
    check(!pending() && !buffered() && bytes_done() == 0U, "reset clears buffered work");
    check(results == old_results && replies == old_replies, "aborted work has no success reply");

    const uint32_t after_reset = 0x5a5aa5a5U;
    command(0x1eU, after_reset, false);
    accept_and_compute(after_reset);
    blocked();
    check_result(old_results, after_reset);
    blocked();
    check(replies == old_replies + 1U && last_reply == 0x1eU, "fresh work completes after reset");
    for (unsigned j = 0; j < 4U; ++j) step();
    check(results == old_results + 1U && replies == old_replies + 1U,
          "no extra results or replies after idle");

    std::printf("PASS FASE popcount cycles=%u checks=%u results=%u replies=%u\n",
                cycle, checks, results, replies);
}
