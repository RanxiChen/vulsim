#pragma once

#include <defhelper.hpp>

INTERFACE() {
    PARAMETER(ERROR_REPLY, 0xff);

    // Host byte stream and reply byte stream.
    SERVICE(host2ctrl, handshake=1, ARG(uint8_t) data);
    REQUEST(ctrl2host, handshake=1, ARG(uint8_t) data);

    // CPU status is sampled every cycle, without a handshake.
    REQUEST(fase_status, handshake=0,
        RESP(Int<2>) priv, RESP(bool) inject_pending);
    REQUEST(fase_control, handshake=0, ARG(bool) stop_fetch);

    // Acceptance is separate from retirement reported by inject_pending.
    REQUEST(inject, handshake=1, ARG(uint32_t) inst);
}

CONFIG(SEROP_INST, 30);
CONFIG(PRIV_M, 3);
CONFIG(ST_IDLE, 0);
CONFIG(ST_RECV_ARGS, 1);
CONFIG(ST_WAIT_INJECT, 2);
CONFIG(ST_WAIT_RETIRE, 3);
CONFIG(ST_SEND_OK, 4);
CONFIG(ST_SEND_ERROR, 5);

REGISTER(state, uint8_t) { state = ST_IDLE; }
REGISTER(command_head, uint8_t) { command_head = 0; }
REGISTER(arg_pos, uint8_t) { arg_pos = 0; }
// Preserve the original frame field; this single-core demo does not route by ID.
REGISTER(cpu_id, uint8_t) { cpu_id = 0; }
REGISTER(inst_buffer, uint32_t) { inst_buffer = 0; }

SERVICE(host2ctrl, handshake=1,
    ready=(state == ST_IDLE || state == ST_RECV_ARGS), ARG(uint8_t) data) {
    if (state == ST_IDLE) {
        command_head.setnext(data);
        arg_pos.setnext(0);
        inst_buffer.setnext(0);
        if ((data & 0x1fU) == SEROP_INST) {
            state.setnext(ST_RECV_ARGS);
        } else {
            // Reject this head immediately; the next accepted byte is a new head.
            state.setnext(ST_SEND_ERROR);
        }
    } else {
        if (arg_pos == 0U) {
            cpu_id.setnext(data);
            arg_pos.setnext(1);
        } else {
            // Four instruction bytes arrive least-significant byte first.
            uint32_t byte_bits = static_cast<uint32_t>(data);
            if (arg_pos == 2U) byte_bits = byte_bits << 8U;
            else if (arg_pos == 3U) byte_bits = byte_bits << 16U;
            else if (arg_pos == 4U) byte_bits = byte_bits << 24U;
            inst_buffer.setnext(static_cast<uint32_t>(inst_buffer) | byte_bits);
            if (arg_pos == 4U) {
                state.setnext(ST_WAIT_INJECT);
            } else {
                arg_pos.setnext(arg_pos + 1U);
            }
        }
    }
}

TICK_IMPL() {
    Int<2> priv = 0;
    bool inject_pending = false;
    fase_status(priv, inject_pending);
    bool in_m = (priv == PRIV_M);
    fase_control(in_m);

    if (state == ST_WAIT_INJECT) {
        if (in_m && !inject_pending) {
            if (inject(inst_buffer)) {
                state.setnext(ST_WAIT_RETIRE);
            }
        }
    } else if (state == ST_WAIT_RETIRE) {
        // This branch first runs in the cycle after the acceptance handshake.
        if (!inject_pending) {
            state.setnext(ST_SEND_OK);
        }
    } else if (state == ST_SEND_OK || state == ST_SEND_ERROR) {
        // A single call site serves both reply states. Success echoes the head.
        uint8_t reply = (state == ST_SEND_OK)
            ? static_cast<uint8_t>(command_head)
            : static_cast<uint8_t>(ERROR_REPLY);
        if (ctrl2host(reply)) {
            state.setnext(ST_IDLE);
        }
    }
}
